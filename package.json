{
  "name": "sia-batetangnga",
  "version": "1.0.0",
  "description": "Sistem Informasi Desa Batetangnga Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron:start": "electron .",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win nsis",
    "import-csv": "node scripts/import-csv.js",
    "seed-admin": "node scripts/seed-admin-supabase.js",
    "audit:egress": "node scripts/audit-supabase-calls.cjs",
    "test:rab-perubahan": "node scripts/test-rab-perubahan.cjs",
    "test:rkpdes-perubahan": "node scripts/test-rkpdes-perubahan.cjs",
    "test:rktl-perubahan": "node scripts/test-rktl-perubahan.cjs",
    "test:pagu-indikatif-perubahan": "node scripts/test-pagu-indikatif-perubahan.cjs",
    "check:all": "npm run audit:egress && node --check server.js && node --check frontend/rkpdes.js && node --check frontend/rktl.js && node --check frontend/rab.js && node --check frontend/pagu-indikatif.js && node --check frontend/rpjmdesModule.js && node --check backend/services/rpjmdesService.js && node --check scripts/import-csv.js && npm run test:rab-perubahan && npm run test:rkpdes-perubahan && npm run test:rktl-perubahan && npm run test:pagu-indikatif-perubahan",
    "test": "node scripts/test-rab-perubahan.cjs && node scripts/test-rkpdes-perubahan.cjs && node scripts/test-rktl-perubahan.cjs && node scripts/test-pagu-indikatif-perubahan.cjs"
  },
  "keywords": [
    "electron",
    "desa",
    "batetangnga",
    "sia"
  ],
  "author": "Pemerintah Desa Batetangnga",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.siabatetangnga.app",
    "productName": "SIA Batetangnga",
    "copyright": "Copyright © 2026 Desa Batetangnga",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "frontend/**/*",
      "backend/**/*",
      "templates/**/*",
      ".env",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SIA Batetangnga"
    }
  }
}
